# RASCUNHO para <fork>/servidor-mcp/.env.example — SEM valores reais (repositorio publico).
# Gerar:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#     ou: python3 -c "import secrets; print(secrets.token_hex(32))"   (Windows: python / py -3)
REQUEST_STATE_SECRET=<cole-aqui-64-hex-gerados-localmente>
# Opcionais (defaults do enunciado)
MCP_PORT=7301
