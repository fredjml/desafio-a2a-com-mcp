# Referencia das variaveis do servidor MCP. SEM valores reais (repositorio publico).
# O servidor NAO le este arquivo: exporte as variaveis no terminal antes de `python -m app`
# (veja "Como rodar" no README). Um `.env` local esta no .gitignore; nunca o versione.
#
# Obrigatoria: chave do requestState, 32 bytes = 64 caracteres hexadecimais. Gere com um destes:
#   python3 -c "import secrets; print(secrets.token_hex(32))"     (Windows: python -c ... ou py -3 -c ...)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REQUEST_STATE_SECRET=<cole-aqui-64-hex-gerados-localmente>

# Opcionais (os valores abaixo sao os padroes)
MCP_PORT=7301
# Validade do requestState em segundos (1 a 1800). O padrao (600) atende ao enunciado (5 a 30 min);
# reduza so para testar expiracao.
REQUEST_STATE_TTL_S=600
# Pasta com salas.json, reservas.json e politica-de-uso.md (padrao: <raiz do repositorio>/dados)
# DADOS_DIR=
